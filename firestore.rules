rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Protected secrets: ONLY accessible when logged in via passcode
    match /secrets/{secretId} {
      allow read: if request.auth != null;
      allow write: if false;
    }
    
    // Public data: all other collections are publicly readable
    match /{collection}/{document=**} {
      allow read: if collection != 'secrets';
      allow write: if false;
    }
  }
}

